<Window x:Class="EngineeringCalculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EngineeringCalculator"
        Title="Инженерный калькулятор" Height="620" Width="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True">

    <Window.Resources>
        <local:BoolToDegRadConverter x:Key="BoolToDegRadConverter"/>

        <!-- Тень для окна -->
        <DropShadowEffect x:Key="WindowShadow" Color="#000000" ShadowDepth="2" BlurRadius="15" Opacity="0.5"/>

        <!-- Стили для кнопок управления окном -->
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="3"
                                BorderBrush="#4a5f6b"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#34495e"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#566573"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2c3e50"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Основной стиль для кнопок -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2a363c"/>
            <Setter Property="Foreground" Value="#ecf0f1"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="3"
                                BorderBrush="#3498db"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#566573"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#35434b"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для кнопок цифр -->
        <Style x:Key="NumberButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#1f282d"/>
            <Setter Property="Foreground" Value="#ecf0f1"/>
            <Setter Property="FontSize" Value="22"/>
        </Style>

        <!-- Стиль для светлых кнопок -->
        <Style x:Key="LightGrayButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#2a363c"/>
            <Setter Property="Foreground" Value="#ecf0f1"/>
            <Setter Property="FontSize" Value="20"/>
        </Style>

        <!-- Стиль для оранжевых операторов -->
        <Style x:Key="OperatorButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#FF9500"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>

        <!-- Стиль для кнопки равно -->
        <Style x:Key="EqualButtonStyle" TargetType="Button" BasedOn="{StaticResource OperatorButtonStyle}">
            <Setter Property="Background" Value="#FF9500"/>
        </Style>

        <!-- Стиль для функциональных кнопок -->
        <Style x:Key="FunctionButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#2a363c"/>
            <Setter Property="Foreground" Value="#3498db"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Стиль для кнопок констант -->
        <Style x:Key="ConstantButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#2a363c"/>
            <Setter Property="Foreground" Value="#e74c3c"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- СТИЛЬ ДЛЯ МАЛЕНЬКИХ КНОПОК -->
        <Style x:Key="SmallButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2a363c"/>
            <Setter Property="Foreground" Value="#ecf0f1"/>
            <Setter Property="BorderThickness" Value="0.5"/>
            <Setter Property="BorderBrush" Value="#1f282d"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Height" Value="55"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"
                                            RecognizesAccessKey="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#34495e"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1f282d"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для МАЛЕНЬКИХ кнопок цифр -->
        <Style x:Key="SmallNumberButtonStyle" TargetType="Button" BasedOn="{StaticResource SmallButtonStyle}">
            <Setter Property="Background" Value="#1f282d"/>
            <Setter Property="Foreground" Value="#ecf0f1"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Стиль для МАЛЕНЬКИХ функциональных кнопок -->
        <Style x:Key="SmallFunctionButtonStyle" TargetType="Button" BasedOn="{StaticResource SmallButtonStyle}">
            <Setter Property="Background" Value="#2a363c"/>
            <Setter Property="Foreground" Value="#3498db"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Стиль для МАЛЕНЬКИХ кнопок констант -->
        <Style x:Key="SmallConstantButtonStyle" TargetType="Button" BasedOn="{StaticResource SmallButtonStyle}">
            <Setter Property="Background" Value="#2a363c"/>
            <Setter Property="Foreground" Value="#e74c3c"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Стиль для МАЛЕНЬКИХ операторов -->
        <Style x:Key="SmallOperatorButtonStyle" TargetType="Button" BasedOn="{StaticResource SmallButtonStyle}">
            <Setter Property="Background" Value="#FF9500"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Стиль для МАЛЕНЬКОЙ кнопки равно -->
        <Style x:Key="SmallEqualButtonStyle" TargetType="Button" BasedOn="{StaticResource SmallOperatorButtonStyle}">
            <Setter Property="Background" Value="#FF9500"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <!-- Стиль для TextBox -->
        <Style x:Key="RoundedTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#151b1e"/>
            <Setter Property="Foreground" Value="#ecf0f1"/>
            <Setter Property="BorderBrush" Value="#2a363c"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для ToggleButton -->
        <Style x:Key="RoundedToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#2a363c"/>
            <Setter Property="Foreground" Value="#ecf0f1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2a363c"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3498db"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#3498db"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#34495e"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для TabControl -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="#151b1e"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="TabStripPlacement" Value="Top"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#7f8c8d"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid>
                            <Border x:Name="border" 
                                    Background="{TemplateBinding Background}"
                                    BorderThickness="0"
                                    CornerRadius="3"
                                    Margin="3,0">
                                <ContentPresenter x:Name="contentPresenter"
                                                  ContentSource="Header"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2a363c"/>
                                <Setter Property="Foreground" Value="#3498db"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2a363c"/>
                                <Setter Property="Foreground" Value="#ecf0f1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для красивых ToolTip'ов -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#2a363c"/>
            <Setter Property="Foreground" Value="#ecf0f1"/>
            <Setter Property="BorderBrush" Value="#3498db"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="250"/>
            <Setter Property="ToolTipService.ShowDuration" Value="5000"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Горизонтальный контейнер для калькулятора и панели истории -->
    <Border Background="#1f282d" CornerRadius="8" MouseDown="Border_MouseDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="0" Color="#000000" Opacity="0.5"/>
        </Border.Effect>

        <Grid>
            <!-- Заголовок -->
            <Border Background="#151b1e" Height="26" VerticalAlignment="Top" CornerRadius="8,8,0,0" Panel.ZIndex="10">
                <Grid>
                    <TextBlock Text="ИНЖЕНЕРНЫЙ КАЛЬКУЛЯТОР" Foreground="White" VerticalAlignment="Center"
                               Margin="10,0,0,0" FontSize="11" FontWeight="SemiBold"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="─" Width="26" Background="Transparent" Foreground="White" 
                                BorderThickness="0" FontSize="10" Click="MinimizeButton_Click"
                                Style="{StaticResource SidebarButtonStyle}"
                                ToolTip="Свернуть"/>
                        <Button Content="✕" Width="26" Background="Transparent" Foreground="White" 
                                BorderThickness="0" FontSize="10" Click="CloseButton_Click"
                                Style="{StaticResource SidebarButtonStyle}"
                                ToolTip="Закрыть"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Разделитель между заголовком и основным контентом -->
            <Border Background="#000000" Height="1" VerticalAlignment="Top" Margin="0,26,0,0" Panel.ZIndex="10"/>

            <!-- Основное содержимое -->
            <Grid Margin="0,27,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>

                <!-- ОСНОВНОЙ КАЛЬКУЛЯТОР -->
                <Border Grid.Column="0" Background="#1f282d" CornerRadius="0" Padding="3">
                    <TabControl>
                        <!-- БАЗОВЫЙ РЕЖИМ -->
                        <TabItem Header="Базовый">
                            <Grid Background="#1f282d">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="120"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Область дисплея -->
                                <Border Grid.Row="0" Background="#151b1e" Padding="15" Margin="0,0,0,5">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Основной дисплей -->
                                        <Border Grid.Row="0" 
                                              Background="Transparent" 
                                              BorderThickness="0"
                                              Padding="0">
                                            <ScrollViewer HorizontalScrollBarVisibility="Auto" 
                                                        VerticalScrollBarVisibility="Disabled"
                                                        VerticalAlignment="Center">
                                                <TextBlock x:Name="DisplayTextBlock" 
                                                         FontSize="42" 
                                                         Foreground="#ecf0f1" 
                                                         TextAlignment="Right"
                                                         Text="0"
                                                         FontFamily="Segoe UI Light"
                                                         HorizontalAlignment="Right"
                                                         VerticalAlignment="Center"
                                                         LineHeight="42"/>
                                            </ScrollViewer>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Клавиатура калькулятора -->
                                <Grid Grid.Row="1" Background="#1f282d" Margin="8,0,8,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Первый ряд -->
                                    <UniformGrid Grid.Row="0" Columns="4" Rows="1">
                                        <Button Content="C" Click="ClearButton_Click" Style="{StaticResource LightGrayButtonStyle}"
                                                ToolTip="Очистить"/>
                                        <Button Content="+/-" Click="NegateButton_Click" Style="{StaticResource LightGrayButtonStyle}"
                                                ToolTip="Смена знака"/>
                                        <Button Content="%" Click="AppendButton_Click" Style="{StaticResource LightGrayButtonStyle}"
                                                ToolTip="Процент"/>
                                        <Button Content="÷" Click="AppendButton_Click" Style="{StaticResource OperatorButtonStyle}"
                                                ToolTip="Деление"/>
                                    </UniformGrid>

                                    <!-- Второй ряд -->
                                    <UniformGrid Grid.Row="1" Columns="4" Rows="1">
                                        <Button Content="7" Click="NumberButton_Click" Style="{StaticResource NumberButtonStyle}"/>
                                        <Button Content="8" Click="NumberButton_Click" Style="{StaticResource NumberButtonStyle}"/>
                                        <Button Content="9" Click="NumberButton_Click" Style="{StaticResource NumberButtonStyle}"/>
                                        <Button Content="×" Click="AppendButton_Click" Style="{StaticResource OperatorButtonStyle}"
                                                ToolTip="Умножение"/>
                                    </UniformGrid>

                                    <!-- Третий ряд -->
                                    <UniformGrid Grid.Row="2" Columns="4" Rows="1">
                                        <Button Content="4" Click="NumberButton_Click" Style="{StaticResource NumberButtonStyle}"/>
                                        <Button Content="5" Click="NumberButton_Click" Style="{StaticResource NumberButtonStyle}"/>
                                        <Button Content="6" Click="NumberButton_Click" Style="{StaticResource NumberButtonStyle}"/>
                                        <Button Content="-" Click="AppendButton_Click" Style="{StaticResource OperatorButtonStyle}"
                                                ToolTip="Вычитание"/>
                                    </UniformGrid>

                                    <!-- Четвертый ряд -->
                                    <UniformGrid Grid.Row="3" Columns="4" Rows="1">
                                        <Button Content="1" Click="NumberButton_Click" Style="{StaticResource NumberButtonStyle}"/>
                                        <Button Content="2" Click="NumberButton_Click" Style="{StaticResource NumberButtonStyle}"/>
                                        <Button Content="3" Click="NumberButton_Click" Style="{StaticResource NumberButtonStyle}"/>
                                        <Button Content="+" Click="AppendButton_Click" Style="{StaticResource OperatorButtonStyle}"
                                                ToolTip="Сложение"/>
                                    </UniformGrid>

                                    <!-- Пятый ряд -->
                                    <Grid Grid.Row="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Content="0" Grid.Column="0" Click="NumberButton_Click" 
                                                Style="{StaticResource NumberButtonStyle}" HorizontalAlignment="Stretch"/>
                                        <Button Content="." Grid.Column="1" Click="DecimalButton_Click" 
                                                Style="{StaticResource LightGrayButtonStyle}" ToolTip="Точка"/>
                                        <Button Content="=" Grid.Column="2" Click="EqualsButton_Click" 
                                                Style="{StaticResource EqualButtonStyle}" ToolTip="Вычислить"/>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </TabItem>

                        <!-- ИНЖЕНЕРНЫЙ РЕЖИМ -->
                        <TabItem Header="Инженерный">
                            <Grid Background="#1f282d">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="120"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Область дисплея -->
                                <Border Grid.Row="0" Background="#151b1e" Padding="15" Margin="0,0,0,3">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Основной дисплей -->
                                        <Border Grid.Row="0" 
                      Background="Transparent" 
                      BorderThickness="0"
                      Padding="0">
                                            <ScrollViewer HorizontalScrollBarVisibility="Auto" 
                                VerticalScrollBarVisibility="Disabled"
                                VerticalAlignment="Center">
                                                <TextBlock x:Name="SciDisplayTextBlock" 
                                 FontSize="30" 
                                 Foreground="#ecf0f1" 
                                 TextAlignment="Right"
                                 Text="0"
                                 FontFamily="Segoe UI Light"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Center"
                                 LineHeight="30"/>
                                            </ScrollViewer>
                                        </Border>

                                        <!-- Режим вычислений -->
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,5,0,0">
                                            <ToggleButton x:Name="DegreesToggle" 
                                Content="DEG" 
                                IsChecked="True"
                                Style="{StaticResource RoundedToggleButtonStyle}"
                                FontSize="11"
                                Padding="0"
                                ToolTip="Переключить режим градусы/радианы"/>
                                            <TextBlock VerticalAlignment="Center" 
                             Margin="8,0" 
                             Foreground="#7f8c8d"
                             FontSize="11"
                             Text="{Binding ElementName=DegreesToggle, Path=IsChecked, 
                                    Converter={StaticResource BoolToDegRadConverter}}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- ИНЖЕНЕРНАЯ КЛАВИАТУРА -->
                                <Grid Grid.Row="1" Background="#1f282d">
                                    <!-- ОСНОВНАЯ КЛАВИАТУРА (всегда видимая) -->
                                    <Grid x:Name="MainKeyboard" Background="#1f282d" Margin="5">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Верхняя панель с кнопками меню -->
                                        <Border Grid.Row="0" Background="#151b1e" CornerRadius="3" Padding="2" Margin="0,0,0,5" Height="35">
                                            <StackPanel Orientation="Horizontal">
                                                <ToggleButton x:Name="TrigonometryMenuButton" 
                                    Content="Тригонометрия" 
                                    Style="{StaticResource RoundedToggleButtonStyle}"
                                    Width="100" Height="30" FontSize="11"
                                    Margin="2,0"
                                    Background="#2a363c"
                                    Foreground="#3498db"
                                    Cursor="Hand"/>

                                                <ToggleButton x:Name="FunctionsMenuButton" 
                                    Content="Функции" 
                                    Style="{StaticResource RoundedToggleButtonStyle}"
                                    Width="80" Height="30" FontSize="11"
                                    Margin="2,0"
                                    Background="#2a363c"
                                    Foreground="#e74c3c"
                                    Cursor="Hand"/>

                                                <ToggleButton x:Name="ConstantsMenuButton" 
                                    Content="Константы" 
                                    Style="{StaticResource RoundedToggleButtonStyle}"
                                    Width="90" Height="30" FontSize="11"
                                    Margin="2,0"
                                    Background="#2a363c"
                                    Foreground="#f39c12"
                                    Cursor="Hand"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- ОСНОВНАЯ КЛАВИАТУРА (кнопки) -->
                                        <Grid Grid.Row="1" Background="#1f282d">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <!-- Ряд 1: 2ˣ, π, e, C -->
                                            <UniformGrid Grid.Row="0" Columns="4" Rows="1">
                                                <Button Content="2ˣ" Click="FunctionButton_Click" Style="{StaticResource SmallFunctionButtonStyle}" ToolTip="2 в степени x"/>
                                                <Button Content="π" Click="ConstantButton_Click" Style="{StaticResource SmallConstantButtonStyle}" ToolTip="Число Пи"/>
                                                <Button Content="e" Click="ConstantButton_Click" Style="{StaticResource SmallConstantButtonStyle}" ToolTip="Число Эйлера"/>
                                                <Button Content="C" Click="ClearButton_Click" Style="{StaticResource SmallFunctionButtonStyle}" ToolTip="Очистить"/>
                                            </UniformGrid>

                                            <!-- Ряд 2: x², √x, |x|, exp, mod -->
                                            <UniformGrid Grid.Row="1" Columns="5" Rows="1">
                                                <Button Content="x²" Click="FunctionButton_Click" Style="{StaticResource SmallFunctionButtonStyle}" ToolTip="Квадрат числа"/>
                                                <Button Content="√x" Click="FunctionButton_Click" Style="{StaticResource SmallFunctionButtonStyle}" ToolTip="Квадратный корень"/>
                                                <Button Content="|x|" Click="FunctionButton_Click" Style="{StaticResource SmallFunctionButtonStyle}" ToolTip="Модуль числа"/>
                                                <Button Content="exp" Click="FunctionButton_Click" Style="{StaticResource SmallFunctionButtonStyle}" ToolTip="Экспонента"/>
                                                <Button Content="mod" Click="AppendButton_Click" Style="{StaticResource SmallFunctionButtonStyle}" ToolTip="Остаток от деления"/>
                                            </UniformGrid>

                                            <!-- Ряд 3: ∛x, (, ), n!, ÷ -->
                                            <UniformGrid Grid.Row="2" Columns="5" Rows="1">
                                                <Button Content="∛x" Click="FunctionButton_Click" Style="{StaticResource SmallFunctionButtonStyle}" ToolTip="Кубический корень"/>
                                                <Button Content="(" Click="AppendButton_Click" Style="{StaticResource SmallFunctionButtonStyle}" ToolTip="Открывающая скобка"/>
                                                <Button Content=")" Click="AppendButton_Click" Style="{StaticResource SmallFunctionButtonStyle}" ToolTip="Закрывающая скобка"/>
                                                <Button Content="n!" Click="FunctionButton_Click" Style="{StaticResource SmallFunctionButtonStyle}" ToolTip="Факториал"/>
                                                <Button Content="÷" Click="AppendButton_Click" Style="{StaticResource SmallOperatorButtonStyle}" ToolTip="Деление"/>
                                            </UniformGrid>

                                            <!-- Ряд 4: x^y, 7, 8, 9, × -->
                                            <UniformGrid Grid.Row="3" Columns="5" Rows="1">
                                                <Button Content="x^y" Click="AppendButton_Click" Style="{StaticResource SmallFunctionButtonStyle}" ToolTip="Возведение в степень"/>
                                                <Button Content="7" Click="NumberButton_Click" Style="{StaticResource SmallNumberButtonStyle}"/>
                                                <Button Content="8" Click="NumberButton_Click" Style="{StaticResource SmallNumberButtonStyle}"/>
                                                <Button Content="9" Click="NumberButton_Click" Style="{StaticResource SmallNumberButtonStyle}"/>
                                                <Button Content="×" Click="AppendButton_Click" Style="{StaticResource SmallOperatorButtonStyle}" ToolTip="Умножение"/>
                                            </UniformGrid>

                                            <!-- Ряд 5: 10ˣ, 4, 5, 6, − -->
                                            <UniformGrid Grid.Row="4" Columns="5" Rows="1">
                                                <Button Content="10ˣ" Click="FunctionButton_Click" Style="{StaticResource SmallFunctionButtonStyle}" ToolTip="10 в степени x"/>
                                                <Button Content="4" Click="NumberButton_Click" Style="{StaticResource SmallNumberButtonStyle}"/>
                                                <Button Content="5" Click="NumberButton_Click" Style="{StaticResource SmallNumberButtonStyle}"/>
                                                <Button Content="6" Click="NumberButton_Click" Style="{StaticResource SmallNumberButtonStyle}"/>
                                                <Button Content="-" Click="AppendButton_Click" Style="{StaticResource SmallOperatorButtonStyle}" ToolTip="Вычитание"/>
                                            </UniformGrid>

                                            <!-- Ряд 6: log, 1, 2, 3, + -->
                                            <UniformGrid Grid.Row="5" Columns="5" Rows="1">
                                                <Button Content="log" Click="FunctionButton_Click" Style="{StaticResource SmallFunctionButtonStyle}" ToolTip="Десятичный логарифм"/>
                                                <Button Content="1" Click="NumberButton_Click" Style="{StaticResource SmallNumberButtonStyle}"/>
                                                <Button Content="2" Click="NumberButton_Click" Style="{StaticResource SmallNumberButtonStyle}"/>
                                                <Button Content="3" Click="NumberButton_Click" Style="{StaticResource SmallNumberButtonStyle}"/>
                                                <Button Content="+" Click="AppendButton_Click" Style="{StaticResource SmallOperatorButtonStyle}" ToolTip="Сложение"/>
                                            </UniformGrid>

                                            <!-- Ряд 7: ln, +/-, 0, ,, = -->
                                            <UniformGrid Grid.Row="6" Columns="5" Rows="1">
                                                <Button Content="ln" Click="FunctionButton_Click" Style="{StaticResource SmallFunctionButtonStyle}" ToolTip="Натуральный логарифм"/>
                                                <Button Content="+/-" Click="NegateButton_Click" Style="{StaticResource SmallFunctionButtonStyle}" ToolTip="Смена знака"/>
                                                <Button Content="0" Click="NumberButton_Click" Style="{StaticResource SmallNumberButtonStyle}"/>
                                                <Button Content="," Click="DecimalButton_Click" Style="{StaticResource SmallFunctionButtonStyle}" ToolTip="Десятичная точка"/>
                                                <Button Content="=" Click="EqualsButton_Click" Style="{StaticResource SmallEqualButtonStyle}" ToolTip="Вычислить"/>
                                            </UniformGrid>
                                        </Grid>
                                    </Grid>

                                    <!-- ВСПЛЫВАЮЩИЕ МЕНЮ (используем Popup) -->
                                    <!-- Popup не перекрывает основной интерфейс и позволяет кликать по кнопкам под ним -->

                                    <!-- Popup для тригонометрии -->
                                    <Popup x:Name="TrigonometryPopup"
                   PlacementTarget="{Binding ElementName=TrigonometryMenuButton}"
                   Placement="Bottom"
                   StaysOpen="False"
                   IsOpen="{Binding ElementName=TrigonometryMenuButton, Path=IsChecked}"
                   PopupAnimation="Slide"
                   AllowsTransparency="True"
                   HorizontalOffset="-150"
                   VerticalOffset="5">
                                        <Border Background="#151b1e" 
                        CornerRadius="3" 
                        Padding="5" 
                        Width="430"
                        BorderBrush="#3498db"
                        BorderThickness="2">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Заголовок -->
                                                <Border Grid.Row="0" Background="#2a363c" Padding="5" CornerRadius="2" Margin="0,0,0,5">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Тригонометрические функции" Foreground="#3498db" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                                        <Button Grid.Column="1" 
                                        Content="✕" 
                                        Width="18" 
                                        Height="18" 
                                        Background="Transparent" 
                                        Foreground="#7f8c8d" 
                                        BorderThickness="0" 
                                        FontSize="11"
                                        Click="ClosePopupButton_Click"
                                        Tag="Trigonometry"
                                        Cursor="Hand"
                                        ToolTip="Закрыть"/>
                                                    </Grid>
                                                </Border>

                                                <!-- Основные тригонометрические функции -->
                                                <UniformGrid Grid.Row="1" Columns="6" Rows="1" Margin="0,2">
                                                    <Button Content="sin" Click="FunctionButton_Click" Style="{StaticResource SmallFunctionButtonStyle}" ToolTip="Синус" Height="34" Margin="1"/>
                                                    <Button Content="cos" Click="FunctionButton_Click" Style="{StaticResource SmallFunctionButtonStyle}" ToolTip="Косинус" Height="34" Margin="1"/>
                                                    <Button Content="tan" Click="FunctionButton_Click" Style="{StaticResource SmallFunctionButtonStyle}" ToolTip="Тангенс" Height="34" Margin="1"/>
                                                    <Button Content="cot" Click="FunctionButton_Click" Style="{StaticResource SmallFunctionButtonStyle}" ToolTip="Котангенс" Height="34" Margin="1"/>
                                                    <Button Content="sec" Click="FunctionButton_Click" Style="{StaticResource SmallFunctionButtonStyle}" ToolTip="Секанс" Height="34" Margin="1"/>
                                                    <Button Content="csc" Click="FunctionButton_Click" Style="{StaticResource SmallFunctionButtonStyle}" ToolTip="Косеканс" Height="34" Margin="1"/>
                                                </UniformGrid>

                                                <!-- Обратные тригонометрические функции -->
                                                <UniformGrid Grid.Row="2" Columns="6" Rows="1" Margin="0,2">
                                                    <Button Content="asin" Click="FunctionButton_Click" Style="{StaticResource SmallFunctionButtonStyle}" ToolTip="Арксинус" Height="34" Margin="1"/>
                                                    <Button Content="acos" Click="FunctionButton_Click" Style="{StaticResource SmallFunctionButtonStyle}" ToolTip="Арккосинус" Height="34" Margin="1"/>
                                                    <Button Content="atan" Click="FunctionButton_Click" Style="{StaticResource SmallFunctionButtonStyle}" ToolTip="Арктангенс" Height="34" Margin="1"/>
                                                    <Button Content="acot" Click="FunctionButton_Click" Style="{StaticResource SmallFunctionButtonStyle}" ToolTip="Арккотангенс" Height="34" Margin="1"/>
                                                    <Button Content="asec" Click="FunctionButton_Click" Style="{StaticResource SmallFunctionButtonStyle}" ToolTip="Арксеканс" Height="34" Margin="1"/>
                                                    <Button Content="acsc" Click="FunctionButton_Click" Style="{StaticResource SmallFunctionButtonStyle}" ToolTip="Арккосеканс" Height="34" Margin="1"/>
                                                </UniformGrid>
                                            </Grid>
                                        </Border>
                                    </Popup>

                                    <!-- Popup для функций -->
                                    <Popup x:Name="FunctionsPopup"
                   PlacementTarget="{Binding ElementName=FunctionsMenuButton}"
                   Placement="Bottom"
                   StaysOpen="False"
                   IsOpen="{Binding ElementName=FunctionsMenuButton, Path=IsChecked}"
                   PopupAnimation="Slide"
                   AllowsTransparency="True"
                   HorizontalOffset="-150"
                   VerticalOffset="5">
                                        <Border Background="#151b1e" 
                        CornerRadius="3" 
                        Padding="5" 
                        Width="430"
                        BorderBrush="#e74c3c"
                        BorderThickness="2">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Заголовок -->
                                                <Border Grid.Row="0" Background="#2a363c" Padding="5" CornerRadius="2" Margin="0,0,0,5">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Функции" Foreground="#e74c3c" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                                        <Button Grid.Column="1" 
                                        Content="✕" 
                                        Width="18" 
                                        Height="18" 
                                        Background="Transparent" 
                                        Foreground="#7f8c8d" 
                                        BorderThickness="0" 
                                        FontSize="11"
                                        Click="ClosePopupButton_Click"
                                        Tag="Functions"
                                        Cursor="Hand"
                                        ToolTip="Закрыть"/>
                                                    </Grid>
                                                </Border>

                                                <!-- Гиперболические функции -->
                                                <UniformGrid Grid.Row="1" Columns="6" Rows="1" Margin="0,2">
                                                    <Button Content="sinh" Click="FunctionButton_Click" Style="{StaticResource SmallFunctionButtonStyle}" ToolTip="Гиперболический синус" Height="34" Margin="1"/>
                                                    <Button Content="cosh" Click="FunctionButton_Click" Style="{StaticResource SmallFunctionButtonStyle}" ToolTip="Гиперболический косинус" Height="34" Margin="1"/>
                                                    <Button Content="tanh" Click="FunctionButton_Click" Style="{StaticResource SmallFunctionButtonStyle}" ToolTip="Гиперболический тангенс" Height="34" Margin="1"/>
                                                    <Button Content="coth" Click="FunctionButton_Click" Style="{StaticResource SmallFunctionButtonStyle}" ToolTip="Гиперболический котангенс" Height="34" Margin="1"/>
                                                    <Button Content="sech" Click="FunctionButton_Click" Style="{StaticResource SmallFunctionButtonStyle}" ToolTip="Гиперболический секанс" Height="34" Margin="1"/>
                                                    <Button Content="csch" Click="FunctionButton_Click" Style="{StaticResource SmallFunctionButtonStyle}" ToolTip="Гиперболический косеканс" Height="34" Margin="1"/>
                                                </UniformGrid>

                                                <!-- Дополнительные функции -->
                                                <UniformGrid Grid.Row="2" Columns="6" Rows="1" Margin="0,2">
                                                    <Button Content="x²" Click="FunctionButton_Click" Style="{StaticResource SmallFunctionButtonStyle}" ToolTip="Квадрат" Height="34" Margin="1"/>
                                                    <Button Content="x³" Click="FunctionButton_Click" Style="{StaticResource SmallFunctionButtonStyle}" ToolTip="Куб" Height="34" Margin="1"/>
                                                    <Button Content="√x" Click="FunctionButton_Click" Style="{StaticResource SmallFunctionButtonStyle}" ToolTip="Квадратный корень" Height="34" Margin="1"/>
                                                    <Button Content="∛x" Click="FunctionButton_Click" Style="{StaticResource SmallFunctionButtonStyle}" ToolTip="Кубический корень" Height="34" Margin="1"/>
                                                    <Button Content="|x|" Click="FunctionButton_Click" Style="{StaticResource SmallFunctionButtonStyle}" ToolTip="Модуль" Height="34" Margin="1"/>
                                                    <Button Content="1/x" Click="FunctionButton_Click" Style="{StaticResource SmallFunctionButtonStyle}" ToolTip="Обратное число" Height="34" Margin="1"/>
                                                </UniformGrid>
                                            </Grid>
                                        </Border>
                                    </Popup>

                                    <!-- Popup для констант -->
                                    <Popup x:Name="ConstantsPopup"
                   PlacementTarget="{Binding ElementName=ConstantsMenuButton}"
                   Placement="Bottom"
                   StaysOpen="False"
                   IsOpen="{Binding ElementName=ConstantsMenuButton, Path=IsChecked}"
                   PopupAnimation="Slide"
                   AllowsTransparency="True"
                   HorizontalOffset="-150"
                   VerticalOffset="5">
                                        <Border Background="#151b1e" 
                        CornerRadius="3" 
                        Padding="5" 
                        Width="380"
                        BorderBrush="#f39c12"
                        BorderThickness="2">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Заголовок -->
                                                <Border Grid.Row="0" Background="#2a363c" Padding="5" CornerRadius="2" Margin="0,0,0,5">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Константы и операции" Foreground="#f39c12" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                                        <Button Grid.Column="1" 
                                        Content="✕" 
                                        Width="18" 
                                        Height="18" 
                                        Background="Transparent" 
                                        Foreground="#7f8c8d" 
                                        BorderThickness="0" 
                                        FontSize="11"
                                        Click="ClosePopupButton_Click"
                                        Tag="Constants"
                                        Cursor="Hand"
                                        ToolTip="Закрыть"/>
                                                    </Grid>
                                                </Border>

                                                <!-- Константы -->
                                                <UniformGrid Grid.Row="1" Columns="5" Rows="1" Margin="0,2">
                                                    <Button Content="π" Click="ConstantButton_Click" Style="{StaticResource SmallConstantButtonStyle}" ToolTip="Число Пи" Height="34" Margin="1"/>
                                                    <Button Content="e" Click="ConstantButton_Click" Style="{StaticResource SmallConstantButtonStyle}" ToolTip="Число Эйлера" Height="34" Margin="1"/>
                                                    <Button Content="2ˣ" Click="FunctionButton_Click" Style="{StaticResource SmallFunctionButtonStyle}" ToolTip="2 в степени x" Height="34" Margin="1"/>
                                                    <Button Content="10ˣ" Click="FunctionButton_Click" Style="{StaticResource SmallFunctionButtonStyle}" ToolTip="10 в степени x" Height="34" Margin="1"/>
                                                    <Button Content="exp" Click="FunctionButton_Click" Style="{StaticResource SmallFunctionButtonStyle}" ToolTip="Экспонента" Height="34" Margin="1"/>
                                                </UniformGrid>
                                            </Grid>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </Grid>
                        </TabItem>

                        <!-- РЕЖИМ ГРАФИКА -->
                        <TabItem Header="График">
                            <Grid Background="#1f282d">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Панель управления графиком -->
                                <Border Grid.Row="0" Background="#151b1e" Padding="5" CornerRadius="3" Margin="3,3,3,2">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Верхняя строка: функция -->
                                        <Grid Grid.Row="0" Margin="0,0,0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="y =" 
                                                     Foreground="#ecf0f1" 
                                                     VerticalAlignment="Center" 
                                                     Margin="0,0,3,0"
                                                     FontSize="10"/>
                                            <TextBox Grid.Column="1"
                                                     x:Name="FunctionTextBox" 
                                                     Text="sin(x)" 
                                                     Height="24" 
                                                     Margin="0,0,3,0"
                                                     Style="{StaticResource RoundedTextBoxStyle}"
                                                     FontSize="10"
                                                     Foreground="#ecf0f1"
                                                     Padding="3,0"/>
                                            <Button Grid.Column="2"
                                                    Content="Построить" 
                                                    Click="PlotButton_Click" 
                                                    Height="24" 
                                                    Width="65"
                                                    Background="#3498db"
                                                    Foreground="#FFFFFF"
                                                    BorderThickness="0"
                                                    FontWeight="Bold"
                                                    FontSize="10"
                                                    Padding="3,0"
                                                    Cursor="Hand"
                                                    ToolTip="Построить график функции"/>
                                        </Grid>

                                        <!-- Средняя строка: диапазон и масштаб -->
                                        <Grid Grid.Row="1" Margin="0,0,0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="X:" 
                                                     Foreground="#ecf0f1" 
                                                     VerticalAlignment="Center" 
                                                     Margin="0,0,2,0"
                                                     FontSize="9"/>
                                            <TextBox Grid.Column="1"
                                                     x:Name="XMinTextBox" 
                                                     Text="-10" 
                                                     Height="22" 
                                                     Margin="0,0,3,0"
                                                     Style="{StaticResource RoundedTextBoxStyle}"
                                                     TextAlignment="Center"
                                                     FontSize="9"
                                                     Foreground="#ecf0f1"
                                                     Padding="2,0"/>

                                            <TextBlock Grid.Column="2"
                                                     Text="до" 
                                                     Foreground="#ecf0f1" 
                                                     VerticalAlignment="Center" 
                                                     Margin="0,0,2,0"
                                                     FontSize="9"/>
                                            <TextBox Grid.Column="3"
                                                     x:Name="XMaxTextBox" 
                                                     Text="10" 
                                                     Height="22" 
                                                     Margin="0,0,5,0"
                                                     Style="{StaticResource RoundedTextBoxStyle}"
                                                     TextAlignment="Center"
                                                     FontSize="9"
                                                     Foreground="#ecf0f1"
                                                     Padding="2,0"/>

                                            <!-- Кнопки управления масштабом -->
                                            <StackPanel Grid.Column="4" Orientation="Horizontal">
                                                <Button Content="⟲" 
                                                        Width="22" 
                                                        Height="22" 
                                                        Background="#2a363c"
                                                        Foreground="#ecf0f1"
                                                        BorderThickness="0"
                                                        FontSize="12"
                                                        Margin="1,0"
                                                        Click="ResetGraphView_Click"
                                                        ToolTip="Сбросить масштаб"
                                                        Cursor="Hand"/>
                                                <Button Content="+" 
                                                        Width="22" 
                                                        Height="22" 
                                                        Background="#2a363c"
                                                        Foreground="#ecf0f1"
                                                        BorderThickness="0"
                                                        FontSize="14"
                                                        FontWeight="Bold"
                                                        Margin="1,0"
                                                        Click="ZoomInGraph_Click"
                                                        ToolTip="Приблизить"
                                                        Cursor="Hand"/>
                                                <Button Content="-" 
                                                        Width="22" 
                                                        Height="22" 
                                                        Background="#2a363c"
                                                        Foreground="#ecf0f1"
                                                        BorderThickness="0"
                                                        FontSize="14"
                                                        FontWeight="Bold"
                                                        Margin="1,0"
                                                        Click="ZoomOutGraph_Click"
                                                        ToolTip="Отдалить"
                                                        Cursor="Hand"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Нижняя строка: информация -->
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                     Text="sin, cos, tg, ctg, arcsin, arccos" 
                                                     Foreground="#7f8c8d" 
                                                     FontSize="8"
                                                     VerticalAlignment="Center"
                                                     TextWrapping="NoWrap"
                                                     TextTrimming="CharacterEllipsis"/>

                                            <TextBlock Grid.Column="1"
                                                     x:Name="GraphInfoText"
                                                     Text="" 
                                                     Foreground="#3498db" 
                                                     FontSize="8"
                                                     FontWeight="Bold"
                                                     VerticalAlignment="Center"
                                                     Margin="5,0,0,0"/>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- Область графика -->
                                <Border Grid.Row="1" 
                                        BorderBrush="#2a363c" 
                                        BorderThickness="1" 
                                        Background="#151b1e" 
                                        CornerRadius="3"
                                        Margin="3,0,3,3">
                                    <Grid>
                                        <Canvas x:Name="GraphCanvas" 
                                                Background="#151b1e" 
                                                ClipToBounds="True"
                                                MouseLeftButtonDown="GraphCanvas_MouseLeftButtonDown"
                                                MouseLeftButtonUp="GraphCanvas_MouseLeftButtonUp"
                                                MouseMove="GraphCanvas_MouseMove"
                                                MouseWheel="GraphCanvas_MouseWheel"
                                                Focusable="True"/>
                                        <TextBlock x:Name="GraphPlaceholder" 
                                                   Text="Введите функцию и нажмите 'Построить'" 
                                                   HorizontalAlignment="Center" 
                                                   VerticalAlignment="Center"
                                                   Foreground="#7f8c8d" 
                                                   TextAlignment="Center"
                                                   FontSize="11"
                                                   FontWeight="Light"
                                                   Panel.ZIndex="10"/>
                                    </Grid>
                                </Border>

                                <!-- Легенда -->
                                <Border Grid.Row="2" Background="#151b1e" Padding="3" CornerRadius="3" Margin="3,0,3,3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,8,0">
                                            <Rectangle Width="12" Height="2" Fill="#00C8FF" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                            <TextBlock Text="график" Foreground="#ecf0f1" FontSize="8" VerticalAlignment="Center" Margin="0,0,6,0"/>

                                            <Ellipse Width="3" Height="3" Fill="#FF6464" Stroke="White" StrokeThickness="0.5" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                            <TextBlock Text="точки" Foreground="#ecf0f1" FontSize="8" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" 
                                                   Foreground="#7f8c8d" 
                                                   FontSize="7"
                                                   TextAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Border>

                <!-- ПАНЕЛЬ ИСТОРИИ (всегда видимая справа) -->
                <Border Grid.Column="1" 
                        Background="#151b1e" 
                        BorderBrush="#2a363c" 
                        BorderThickness="1,0,0,0"
                        CornerRadius="0,0,8,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="32"/>
                        </Grid.RowDefinitions>

                        <!-- Заголовок панели истории -->
                        <Border Grid.Row="0" Background="#1f282d" Padding="5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="ИСТОРИЯ" 
                                           Foreground="#3498db" 
                                           FontWeight="Bold" 
                                           FontSize="11" 
                                           VerticalAlignment="Center"/>

                                <Button Grid.Column="1" 
                                        Content="🗑" 
                                        Width="22" 
                                        Height="22" 
                                        Background="Transparent" 
                                        Foreground="#e74c3c" 
                                        BorderThickness="0" 
                                        FontSize="12" 
                                        Click="ClearHistoryButton_Click"
                                        ToolTip="Очистить историю"
                                        Cursor="Hand"/>
                            </Grid>
                        </Border>

                        <!-- Список истории -->
                        <Border Grid.Row="1" Background="#151b1e" Padding="5">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ListBox x:Name="HistoryListBox" 
                                         Background="Transparent" 
                                         BorderThickness="0"
                                         Foreground="#ecf0f1"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         SelectionMode="Single"
                                         FontSize="10">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Padding" Value="6,6"/>
                                            <Setter Property="Margin" Value="0,0,0,2"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="border" 
                                                                Background="{TemplateBinding Background}"
                                                                BorderBrush="#2a363c"
                                                                BorderThickness="0,0,0,1"
                                                                CornerRadius="2">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock Grid.Column="0" 
                                                                           Text="{TemplateBinding Content}"
                                                                           Foreground="{TemplateBinding Foreground}"
                                                                           TextWrapping="Wrap"
                                                                           HorizontalAlignment="Left"
                                                                           VerticalAlignment="Center"
                                                                           Margin="{TemplateBinding Padding}"/>
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="border" Property="Background" Value="#2a363c"/>
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="border" Property="Background" Value="#3498db"/>
                                                                <Setter Property="Foreground" Value="White"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <EventSetter Event="MouseDoubleClick" Handler="HistoryItem_MouseDoubleClick"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>

                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" 
                                                           Text="{Binding}" 
                                                           TextWrapping="Wrap"
                                                           FontSize="9"
                                                           Foreground="#ecf0f1"/>

                                                <Button Grid.Column="1" 
                                                        Content="📋" 
                                                        Width="18" 
                                                        Height="18" 
                                                        Background="Transparent" 
                                                        Foreground="#7f8c8d" 
                                                        BorderThickness="0" 
                                                        FontSize="10"
                                                        Margin="3,0,0,0"
                                                        ToolTip="Копировать результат"
                                                        Cursor="Hand"
                                                        Click="CopyResult_Click"
                                                        Tag="{Binding}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </ScrollViewer>
                        </Border>

                        <!-- Нижняя панель с информацией -->
                        <Border Grid.Row="2" Background="#1f282d" Padding="5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Записей:" 
                                           Foreground="#7f8c8d" 
                                           FontSize="9" 
                                           VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="1" 
                                           x:Name="HistoryCountText" 
                                           Text="0" 
                                           Foreground="#3498db" 
                                           FontSize="10" 
                                           FontWeight="Bold" 
                                           VerticalAlignment="Center"
                                           Margin="3,0,0,0"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>